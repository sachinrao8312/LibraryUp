rules_version = '2';

// LibraryUp keeps no library data in Firestore: students, payments and attendance live
// on the owner's phone and in their own Google Drive backup. Firestore only holds the
// signed-in owner's account profile and session records.
service cloud.firestore {
  match /databases/{database}/documents {

    // Owner account profile.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Guest accounts. The account-collision flow signs in as a different, existing
    // account and fetches the old guest doc by id to migrate it, so `get` is open to
    // any signed-in user; `list` never is, or anyone could enumerate guests.
    match /guests/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow get: if request.auth != null;
    }

    // Session records. Docs are keyed by user id (AuthRepository) or by a random session id
    // (SessionManager); both carry a `userId` field, so ownership is checked on that field.
    // SessionManager lists a user's active sessions with where("userId", "==", uid), which
    // these rules allow because every returned doc must match.
    match /sessions/{sessionId} {
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
